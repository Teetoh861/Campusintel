# CampusIntel — Environment Variables
#
# Copy this file to .env.local for local development:
#     cp .env.example .env.local
#
# IMPORTANT: Variables prefixed with NEXT_PUBLIC_ are bundled into the
# client-side JavaScript and visible to anyone who loads the site.
# NEVER put secrets, passwords, or private API keys behind a
# NEXT_PUBLIC_ prefix. Server-only secrets must use unprefixed names
# and may only be accessed in Server Components, Route Handlers, or
# Middleware.

# -----------------------------------------------------------------------
# Public site configuration
# -----------------------------------------------------------------------

# Canonical site URL. Used for absolute URLs, sitemaps, and OG metadata.
# Local: http://localhost:3000
# Production: https://your-domain.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp contact number used for course inquiries, tutor signups,
# material submissions, and contact links.
# Format: country code + number, digits only. No leading +, no spaces.
# Example: 2349018750976 (for +234 901 875 0976)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# -----------------------------------------------------------------------
# Admin authentication (server-side only)
# -----------------------------------------------------------------------

# Password for the admin dashboard at /admin.
# Server-side only — must NOT be prefixed with NEXT_PUBLIC_.
# Compared against in middleware or a Route Handler, never in the
# browser.
ADMIN_PASSWORD=

# Secret used to sign admin session cookies. Generate a fresh value with:
#     openssl rand -base64 32
# Server-side only. Rotate if you suspect compromise.
ADMIN_SESSION_SECRET=

# -----------------------------------------------------------------------
# Sanity CMS (added when CMS migration ships)
# -----------------------------------------------------------------------

# Sanity project ID and dataset. Public values — safe to expose.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version. Use a recent ISO date string and pin it.
# Example: 2025-01-01
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity read token for draft/preview content.
# Server-side only — must NOT be prefixed with NEXT_PUBLIC_.
# Public CDN reads do not require a token.
SANITY_API_READ_TOKEN=

# -----------------------------------------------------------------------
# Supabase (student authentication)
# -----------------------------------------------------------------------

# Both Supabase values below are intentionally public and are bundled into
# the client-side JavaScript. That is by design, not an oversight:
#
#   * The anon key is a project identifier, not a credential. It grants no
#     privileged bypass and cannot read or write anything on its own.
#   * Row Level Security in Postgres is the authorization boundary. Every
#     read and write is decided against the signed-in user's JWT, so a
#     student can only ever reach their own row.
#
# There is deliberately no SUPABASE_SERVICE_ROLE_KEY here. The service-role
# key bypasses RLS entirely, and nothing in the application needs it —
# profile creation happens inside Postgres on a confirmation trigger, not
# through a privileged API call. Do not add one "just in case".

# Project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Project anon/publishable key. Public — see the note above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
